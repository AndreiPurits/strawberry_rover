[Unit]
Description=AXM Rover — perception, chassis, fleet agent → rover.axm.tech
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=AXM_AUTO_DETECT_DEVICES=true
Environment=STEREO_SOURCE=realsense
EnvironmentFile=-@HOME@/.config/axm/fleet-agent.env
EnvironmentFile=-@HOME@/.config/axm/devices.env
ExecStart=@REPO_ROOT@/scripts/run_rover_online.sh
Restart=on-failure
RestartSec=20
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
